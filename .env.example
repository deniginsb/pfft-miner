# ============================================================================
# PFFT Miner Config  (CPU)
# ============================================================================
# Copy this file to .env and fill the values you need:
#   cp .env.example .env
# Only PRIVATE_KEY is required. Everything else has sensible defaults.

# ---- REQUIRED ----------------------------------------------------------------

# Your EVM private key (hex, with or without 0x prefix).
# DO NOT share this. DO NOT commit .env.
PRIVATE_KEY=your_private_key_here

# Ethereum mainnet RPC endpoint.
# The public one works but rate-limits aggressively. For real mining use
# Alchemy/Infura/QuickNode/Ankr/blockpi - free tier is enough.
#   Examples:
#     https://eth-mainnet.g.alchemy.com/v2/<YOUR_API_KEY>
#     https://mainnet.infura.io/v3/<YOUR_API_KEY>
#     https://rpc.ankr.com/eth/<YOUR_API_KEY>
ETH_RPC=https://ethereum-rpc.publicnode.com


# ---- CPU TUNING --------------------------------------------------------------

# Number of worker processes. Default = (cpu_count - 1), leaving one core free
# for the OS / Python parent. On a dedicated mining box you can set this to
# exactly cpu_count() to squeeze out the last ~5-10%.
#   8-core CPU  -> WORKERS=7   (or 8 if dedicated)
#   16-core CPU -> WORKERS=15  (or 16 if dedicated)
# If you have hyper-threading, going above physical-core count usually gives
# only 5-15% extra and may hurt thermals.
#WORKERS=7

# Status print interval in seconds (just affects log noise, not performance).
#REPORT_INTERVAL_SEC=5


# ---- GAS / TX TUNING ---------------------------------------------------------

# Gas limit per freeMint tx. 200000 is plenty; rarely need to change.
#GAS_LIMIT=200000

# Gas pricing strategy.
#   MAX_FEE_GWEI=0  (default) -> use the node's suggested legacy gasPrice (safe but
#                                may over/underpay vs current mempool)
#   MAX_FEE_GWEI>0            -> use EIP-1559: cap at MAX_FEE_GWEI, tip MAX_PRIORITY_FEE_GWEI
# Check current mainnet gas at https://etherscan.io/gastracker
# Typical mainnet baseFee these days: ~0.5-3 gwei. For PFFT mint set
# MAX_FEE_GWEI = baseFee_now * 2 + tip  to be safe.
#MAX_FEE_GWEI=5
#MAX_PRIORITY_FEE_GWEI=1

# How long to wait for the mint tx receipt before giving up (seconds).
#TX_TIMEOUT=180

# Sleep between rounds (seconds). 5s is a polite default; you can drop to 0
# if your RPC is dedicated.
#PAUSE_BETWEEN_ROUNDS=5

# Skip mining when wallet ETH balance is below this many ETH (warning only).
#MIN_ETH_BALANCE=0.00005


# ---- RPC / DEBUG -------------------------------------------------------------

# Per-RPC-call timeout in seconds.
#RPC_TIMEOUT=30

# Override the contract / chain (probably never need to touch these).
#CONTRACT=0xEFAd2Eab7172dDEbE5Ce7a41f5Ddf8fCcE4Ca0CB
#CHAIN_ID=1

# Set VERBOSE=true to print extra tx details.
#VERBOSE=false
